# SportBroBot configuration (all optional — sensible defaults are used or
# generated on first run and persisted under ./data/).

# Public base URL of this deployment; used to build the MCP server link
# shown on the dashboard.
SPORTBRO_BASE_URL=http://localhost:8000

# SQLAlchemy database URL. Defaults to sqlite:///./data/sportbrobot.db
# SPORTBRO_DATABASE_URL=sqlite:///./data/sportbrobot.db

# Secret used to sign session cookies. Generated and persisted to
# ./data/secret_key on first run if unset.
# SPORTBRO_SECRET_KEY=

# Fernet key used to encrypt Garmin tokens at rest. Generated and persisted
# to ./data/fernet_key on first run if unset. Must be a valid Fernet key.
# SPORTBRO_FERNET_KEY=

# Directory for the SQLite DB and generated keys. Default: ./data
# SPORTBRO_DATA_DIR=./data
